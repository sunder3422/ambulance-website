# Backend API endpoint that receives enquiry form submissions (POST)
VITE_API_URL=https://api.example.com/api/v1/leads

# Company name shown across the site
VITE_COMPANY_NAME=RapidCare Ambulance & Medical Transport

# Emergency phone number (used for tel: links). Digits, +, spaces only.
VITE_PHONE_NUMBER=+91 98765 43210

# WhatsApp number in international format, digits only, no + or spaces (used for wa.me links)
VITE_WHATSAPP_NUMBER=919876543210

# Default WhatsApp prefilled message
VITE_WHATSAPP_MESSAGE=Hello, I need assistance with medical transportation.

# Optional: Google Maps / geocoding key, if reverse-geocoding is enabled later
VITE_MAPS_API_KEY=

# Optional: analytics measurement ID (e.g. GA4)
VITE_ANALYTICS_ID=
